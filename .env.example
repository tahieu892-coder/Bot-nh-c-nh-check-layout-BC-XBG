# ==== BẮT BUỘC ====
# Token lấy từ @BotFather
BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxxxxxxx

# Chat id của group nhận nhắc/chốt. Thêm bot vào group rồi gõ /id để lấy.
# Group thường có id âm, ví dụ: -1001234567890
REPORT_CHAT_ID=-1001234567890

# ==== NGUỒN DANH SÁCH BC – AM ====
# Link Google Sheets chứa các cột: Mã BC | Bưu Cục | Họ Tên (AM) | Tele (@nick AM).
# Dán link bình thường cũng được, bot tự đổi sang link xuất CSV của đúng tab đang mở.
# Sheet phải để Share = "Anyone with the link" (quyền Viewer là đủ).
# Bỏ trống nếu anh muốn gửi file .csv/.xlsx thẳng vào chat kèm caption /capnhat.
SHEET_URL=

# Giờ tự kéo lại danh sách mỗi ngày (chỉ báo vào group khi có thay đổi)
GIO_SYNC=07:00

# Dòng trong sheet không phải BC cần chụp layout (vd Kho Chuyển Tiếp) — loại khỏi theo dõi.
BO_QUA_BC=
BO_QUA_TU_KHOA=kho chuyen tiep,kct

# ==== TUỲ CHỌN ====
# Các group được phép ghi nhận ảnh (mặc định = REPORT_CHAT_ID). Ngăn cách bằng dấu phẩy.
ALLOWED_CHAT_IDS=

# user_id được dùng lệnh quản trị (/importbc, /xoabc, /reset...). Để trống = ai cũng dùng được.
ADMIN_IDS=

# Ngày bắt đầu bắn báo cáo tự động (YYYY-MM-DD). Trước ngày này bot vẫn đếm ảnh và
# trả lời lệnh nhưng không tự đăng nhắc/chốt vào group. Để trống = áp dụng ngay.
NGAY_BAT_DAU=

# Từ ngày này mới tính phạt (YYYY-MM-DD). Trước đó là giai đoạn nhắc nhở: báo cáo chỉ
# liệt kê BC chưa đạt, không có bảng tiền, và kèm câu nhắc sắp áp dụng phạt.
NGAY_AP_DUNG_PHAT=2026-08-17

TZ=Asia/Ho_Chi_Minh
SO_ANH_YEU_CAU=3

# Khung giờ nhận ảnh. Trước GIO_NHAN_TU bot không tính ảnh, chỉ nhắc gửi lại.
GIO_NHAN_TU=17:00

# Giờ bot gọi cả topic vào chụp hình. Để trống = trùng GIO_NHAN_TU.
GIO_GOI=

# Nick Telegram không muốn bị tag khi bot gọi cả topic lúc GIO_NHAN_TU (bỏ @, cách nhau dấu phẩy)
KHONG_TAG=
GIO_NHAC=20:30
GIO_CHOT=21:30
MUC_PHAT=100000

# ==== SOI ẢNH ====
# Lớp 1 — ĐỘ NÉT: chạy tại chỗ, không cần mạng, không tốn tiền. Ảnh dưới ngưỡng bị
# coi là mờ và bot yêu cầu BC chụp lại. Chạy `python test_soi_anh.py <ảnh...>` trên
# vài ảnh thật để chọn ngưỡng: ảnh nét thường vài trăm–vài nghìn, ảnh rung dưới 50.
NGUONG_NET=60

# Lớp 2 — NỘI DUNG: nhờ Claude xem ảnh có chụp đúng yêu cầu không (ngoại quan phải
# thấy cả biển GHN và bên trong, layout phải thấy tổng thể, WC phải rõ).
# Không điền key thì bot bỏ qua lớp này, chỉ chạy lớp 1.
ANTHROPIC_API_KEY=
BAT_SOI_NOI_DUNG=1

# Model soi ảnh. Mỗi ảnh tốn ~1.100 token vào.
#   claude-opus-5   — chính xác nhất (mặc định)
#   claude-haiku-4-5 — rẻ hơn 5 lần, hợp khi số ảnh mỗi ngày lớn
MODEL_SOI_ANH=claude-opus-5

# Ảnh mờ/sai yêu cầu có bị TRỪ khỏi số ảnh hợp lệ không.
#   0 = bot chỉ nhắn yêu cầu BC chụp lại, vẫn tính đủ ảnh như cũ (mặc định, an toàn)
#   1 = ảnh không đạt không được tính → ảnh hưởng trực tiếp tới tiền phạt của AM
CHAN_ANH_KHONG_DAT=0

# Đường dẫn DB. Trên Railway nên mount volume vào /data rồi đặt DB_PATH=/data/bot.db
DB_PATH=data/bot.db

# ==== SOI CHẤT LƯỢNG ẢNH ====
# Chạy thử: soi và ghi kết quả nhưng không nhắn gì vào group (xem bằng /anhloi)
SOI_CHI_GHI_NHAN=1
# Ngưỡng độ nét: dưới mức này coi là mờ. Đo trên ảnh xám co về 640px.
NGUONG_NET=60
# Soi nội dung bằng Claude vision — cần ANTHROPIC_API_KEY, không có key thì tự bỏ qua
BAT_SOI_NOI_DUNG=1
MODEL_SOI_ANH=claude-opus-5
ANTHROPIC_API_KEY=

# Khuôn tên topic khi bot tự tạo bằng /taotopic
MAU_TEN_TOPIC=AM {ten}
