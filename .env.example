# ==== BẮT BUỘC ====
# Token lấy từ @BotFather
BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxxxxxxx

# Chat id của group nhận nhắc/chốt. Thêm bot vào group rồi gõ /id để lấy.
# Group thường có id âm, ví dụ: -1001234567890
REPORT_CHAT_ID=-1001234567890

# ==== NGUỒN DANH SÁCH BC – AM ====
# Link Google Sheets chứa các cột: Mã BC | Bưu Cục | Họ Tên (AM) | Tele (@nick AM).
# Dán link bình thường cũng được, bot tự đổi sang link xuất CSV của đúng tab đang mở.
# Sheet phải để Share = "Anyone with the link" (quyền Viewer là đủ).
# Bỏ trống nếu anh muốn gửi file .csv/.xlsx thẳng vào chat kèm caption /capnhat.
SHEET_URL=

# Giờ tự kéo lại danh sách mỗi ngày (chỉ báo vào group khi có thay đổi)
GIO_SYNC=07:00

# Dòng trong sheet không phải BC cần chụp layout (vd Kho Chuyển Tiếp) — loại khỏi theo dõi.
BO_QUA_BC=
BO_QUA_TU_KHOA=kho chuyen tiep,kct

# ==== TUỲ CHỌN ====
# Các group được phép ghi nhận ảnh (mặc định = REPORT_CHAT_ID). Ngăn cách bằng dấu phẩy.
ALLOWED_CHAT_IDS=

# user_id được dùng lệnh quản trị (/importbc, /xoabc, /reset...). Để trống = ai cũng dùng được.
ADMIN_IDS=

# Ngày bắt đầu bắn báo cáo tự động (YYYY-MM-DD). Trước ngày này bot vẫn đếm ảnh và
# trả lời lệnh nhưng không tự đăng nhắc/chốt vào group. Để trống = áp dụng ngay.
NGAY_BAT_DAU=

# Từ ngày này mới tính phạt (YYYY-MM-DD). Trước đó là giai đoạn nhắc nhở: báo cáo chỉ
# liệt kê BC chưa đạt, không có bảng tiền, và kèm câu nhắc sắp áp dụng phạt.
NGAY_AP_DUNG_PHAT=2026-08-17

TZ=Asia/Ho_Chi_Minh
SO_ANH_YEU_CAU=2

# Khung giờ nhận ảnh. Trước GIO_NHAN_TU bot không tính ảnh, chỉ nhắc gửi lại.
GIO_NHAN_TU=18:00

# Nick Telegram không muốn bị tag khi bot gọi cả topic lúc GIO_NHAN_TU (bỏ @, cách nhau dấu phẩy)
KHONG_TAG=
GIO_NHAC=20:30
GIO_CHOT=21:30
MUC_PHAT=100000

# Đường dẫn DB. Trên Railway nên mount volume vào /data rồi đặt DB_PATH=/data/bot.db
DB_PATH=data/bot.db
